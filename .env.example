# Robinchan — salin ke `.env` di akar repo. Web, API, dan worker membaca berkas
# yang sama supaya tidak ada nilai yang tercecer di satu proses saja.
#
# Semuanya boleh kosong untuk menjalankan M1+M2 secara lokal: cache dan database
# jatuh ke berkas di `.data/`, dan provider yang belum punya kunci berstatus abu
# ("belum dikonfigurasi") di kartu "Sumber yang dipantau", bukan merah.

# dev | staging | production
# Di `dev`, provider yang gagal atau belum dikonfigurasi diganti data palsu.
RC_ENV=dev
LOG_LEVEL=info

# ---- Chain ----
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_RCHAN_ADDRESS=
TREASURY_ADDRESS=

# ---- Tier (angka belum final, lihat keputusan terbuka #3) ----
TIER_1_MIN=
TIER_2_MIN=
TIER_3_MIN=

# ---- Provider data ----
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
CRYPTOPANIC_API_KEY=
# SEC EDGAR mewajibkan kontak yang bisa dihubungi, mis. "Robinchan dev@contoh.id"
SEC_EDGAR_USER_AGENT=
# Dipakai worker untuk mencari videoId stream yang sedang aktif
YOUTUBE_API_KEY=

# ---- LLM & suara (M3/M4) ----
LLM_API_KEY=
LLM_MODEL=
VOICEVOX_ENDPOINT=

# ---- Infrastruktur ----
# Kosong = pakai berkas di `.data/`. Isi untuk memakai Postgres dan Redis asli.
DATABASE_URL=
REDIS_URL=
JWT_SECRET=

# ---- Heat score ----
HEAT_WEIGHT_ONCHAIN=0.45
HEAT_WEIGHT_NEWS=0.35
HEAT_WEIGHT_SOCIAL=0.20

# ---- Feature flag (semua mati secara default) ----
FEATURE_TRADING=false
FEATURE_VOICE=false
FEATURE_SOCIAL_HEAT=false

# ---- Aset karakter ----
# Ditukar tanpa mengubah kode. Lisensi aset Zundamon masih diperiksa
# (design.md §9), jadi jalurnya sengaja dibaca dari sini.
NEXT_PUBLIC_LIVE2D_MODEL_URL=/live2d/zundamon/zundamon.model3.json

# ---- Alamat antar proses ----
API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_PUBLIC=60
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
