# Robinchan — copy to `.env` at the repo root. Web, API, and worker all read the
# same file so no value ends up stuck in just one process.
#
# Everything can stay empty to run M1+M2 locally: cache and database fall
# back to files in `.data/`, and providers without a key yet show gray
# ("not configured") on the "Sources monitored" card, not red.

# dev | staging | production
# In `dev`, a provider that fails or isn't configured is replaced with fake data.
RC_ENV=dev
LOG_LEVEL=info

# ---- Chain ----
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_RCHAN_ADDRESS=
TREASURY_ADDRESS=

# ---- Tiers (numbers aren't final yet, see open decision #3) ----
TIER_1_MIN=
TIER_2_MIN=
TIER_3_MIN=

# ---- Data providers ----
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
CRYPTOPANIC_API_KEY=
# SEC EDGAR requires a reachable contact, e.g. "Robinchan dev@example.com"
SEC_EDGAR_USER_AGENT=
# Used by the worker to look up the currently active stream videoId
YOUTUBE_API_KEY=

# ---- LLM & voice (M3/M4) ----
LLM_API_KEY=
LLM_MODEL=
VOICEVOX_ENDPOINT=

# ---- Infrastructure ----
# Empty = use files in `.data/`. Fill in to use real Postgres and Redis.
DATABASE_URL=
REDIS_URL=
JWT_SECRET=

# ---- Heat score ----
HEAT_WEIGHT_ONCHAIN=0.45
HEAT_WEIGHT_NEWS=0.35
HEAT_WEIGHT_SOCIAL=0.20

# ---- Feature flags (all off by default) ----
FEATURE_TRADING=false
FEATURE_VOICE=false
FEATURE_SOCIAL_HEAT=false

# ---- Character asset ----
# Swappable without touching code. The Zundamon asset's license is still
# being checked (design.md §9), so the path is deliberately read from here.
NEXT_PUBLIC_LIVE2D_MODEL_URL=/live2d/zundamon/zundamon.model3.json

# ---- Inter-process addresses ----
API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_PUBLIC=60
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
