# Robinchan — copy to `.env` at the repo root. Web, API, and worker all read the
# same file so no value ends up stuck in just one process.
#
# Everything can stay empty to run M1+M2 locally: cache and database fall
# back to files in `.data/`, and providers without a key yet show gray
# ("not configured") on the "Sources monitored" card, not red.

# dev | staging | production
# In `dev`, a provider that fails or isn't configured is replaced with fake data.
RC_ENV=dev
LOG_LEVEL=info

# ---- Chain ----
# Robinhood Chain testnet — confirmed 24 Sep 2026 via eth_chainId against the
# public RPC below. 46630 = 0xb626.
NEXT_PUBLIC_CHAIN_ID=46630
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.chain.robinhood.com
# Set once Bix confirms which of the two addresses shared is the token
# contract (vs. the launch wallet) — see robinchan-trade-heat-portfolio.md §9.
NEXT_PUBLIC_RCHAN_ADDRESS=
TREASURY_ADDRESS=
# Free from cloud.reown.com. Only needed for mobile wallets connecting by QR
# code — browser extension wallets (MetaMask, Rabby) work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Which DEX to route orders through, and its ABI — open decision #4 (brief
# §18), a blocker for M4. Empty means POST /api/order/quote honestly
# refuses instead of guessing at gas or fee numbers.
TRADE_ROUTER_ADDRESS=
# Protocol fee per order, in basis points — open decision #5, also a
# blocker for M4.
TRADE_PROTOCOL_FEE_BPS=

# ---- Tiers (numbers aren't final yet, see open decision #3) ----
TIER_1_MIN=
TIER_2_MIN=
TIER_3_MIN=

# ---- Data providers ----
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
CRYPTOPANIC_API_KEY=
# SEC EDGAR requires a reachable contact, e.g. "Robinchan dev@example.com"
SEC_EDGAR_USER_AGENT=
# Used by the worker to look up the currently active stream videoId
YOUTUBE_API_KEY=

# ---- LLM & voice (M3/M4) ----
# One adapter for every LLM job (apps/api/src/llm/client.ts); the provider is
# configuration, never named in page code. DeepSeek's API is OpenAI-compatible.
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
# Server-only. Never put it in a NEXT_PUBLIC_ variable.
LLM_API_KEY=
# Fast tier for every job. deepseek-v4-pro is the stronger fallback.
LLM_MODEL=deepseek-flash
# Optional: a stronger model for order parsing only, if `npm run eval:parse -w
# @robinchan/api` ever misses the M4 target (plan §5).
LLM_MODEL_PARSE=
VOICEVOX_ENDPOINT=

# ---- Infrastructure ----
# Empty = use files in `.data/`. Fill in to use real Postgres and Redis.
DATABASE_URL=
REDIS_URL=
JWT_SECRET=

# ---- Heat score ----
HEAT_WEIGHT_ONCHAIN=0.45
HEAT_WEIGHT_NEWS=0.35
HEAT_WEIGHT_SOCIAL=0.20

# ---- Feature flags (all off by default) ----
FEATURE_TRADING=false
FEATURE_VOICE=false
FEATURE_SOCIAL_HEAT=false
# Heat / Portfolio / Trade pages (robinchan-trade-heat-portfolio.md §3). Each
# one also flips its sidebar item from "Soon" to a live link. The web app
# reads these FEATURE_* keys from this same root file (next.config.mjs).
# The Trade page reuses FEATURE_TRADING above.
FEATURE_HEAT_PAGE=false
FEATURE_PORTFOLIO_PAGE=false
# Page brief open Q4 — tier needed for the full heat board (H2).
HEAT_FULL_MIN_TIER=1
HEAT_READ_TOP_N=20
PORTFOLIO_DUST_USD=1
# Page brief open Q6 — show tokens Robinchan can't price, in their own section.
PORTFOLIO_SHOW_UNSUPPORTED=true

# ---- Character asset ----
# Swappable without touching code. The Zundamon asset's license is still
# being checked (design.md §9), so the path is deliberately read from here.
NEXT_PUBLIC_LIVE2D_MODEL_URL=/live2d/zundamon/zundamon.model3.json

# ---- Inter-process addresses ----
API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_PUBLIC=60
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
